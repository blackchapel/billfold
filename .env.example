# Copy to .env.local for local development. Never commit real values.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" public key. Safe to expose: row level security denies it everything.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Database (Project Settings > Database > Connection string) ---
# Use the "Transaction pooler" string (port 6543). Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.YOUR-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Billfold ---
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Wraps every organisation's data key. If you lose it, stored secrets cannot be recovered.
MASTER_ENCRYPTION_KEY=
# Comma-separated Google emails that are always allowed in and can open /admin.
SUPER_ADMIN_EMAILS=you@gmail.com
# Public URL of this deployment, no trailing slash (http://localhost:3000 locally).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random string (16+ chars). Vercel cron sends it to /api/health as a Bearer token.
CRON_SECRET=

# --- Tests only (never set on Vercel) ---
# BILLFOLD_TEST_MODE=1                      # fake sign-in for Playwright; ignored in production builds
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/billfold_test
# PW_CHROMIUM_PATH=/path/to/chromium        # optional: use an installed Chromium for verify:ui

# --- Added in later phases (documented now so nothing is a surprise) ---
# GOOGLE_PROJECT_A_CLIENT_ID=      # login + Drive (Phase 2)
# GOOGLE_PROJECT_A_CLIENT_SECRET=
# GOOGLE_PROJECT_B_CLIENT_ID=      # Gmail read + send (Phase 2)
# GOOGLE_PROJECT_B_CLIENT_SECRET=
# GEMINI_API_KEY=                  # bill extraction (Phase 4)
