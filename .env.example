# Copy to .env.local for local development. Never commit real values.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" public key. Safe to expose: row level security denies it everything.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Database (Project Settings > Database > Connection string) ---
# Use the "Session pooler" string (port 5432, IPv4). Not the Transaction pooler (6543): it hangs on reused Vercel instances. Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.YOUR-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Billfold ---
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Wraps every organisation's data key. If you lose it, stored secrets cannot be recovered.
MASTER_ENCRYPTION_KEY=
# Comma-separated Google emails that are always allowed in and can open /admin.
SUPER_ADMIN_EMAILS=you@gmail.com
# Public URL of this deployment, no trailing slash (http://localhost:3000 locally).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random string (16+ chars). Vercel cron sends it to /api/health as a Bearer token.
CRON_SECRET=

# Optional. Shown on the privacy and terms pages as the address for questions and data requests. Without it they say to ask the person who invited you.
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# --- Tests only (never set on Vercel) ---
# BILLFOLD_TEST_MODE=1                      # fake sign-in for Playwright; ignored in production builds
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/billfold_test
# PW_CHROMIUM_PATH=/path/to/chromium        # optional: use an installed Chromium for verify:ui

# --- Connections (Phase 2) ---
# Google project A (verified: Drive, drive.file) and project B (unverified: Gmail). Leave blank until you create them;
# the Connect buttons then show "not set up yet". Redirect URI to register in BOTH projects:
#   https://YOUR-APP-DOMAIN/api/connections/google/callback   (and http://localhost:3000/... for local)
GOOGLE_A_CLIENT_ID=
GOOGLE_A_CLIENT_SECRET=
GOOGLE_B_CLIENT_ID=
GOOGLE_B_CLIENT_SECRET=

# --- Runs (Phase 4) ---
# Optional. Without it bills are read by the built-in text reader and nothing leaves Billfold.
# On Google's free tier, submitted content may be used to improve Google's products (see docs/decisions/0008).
# GEMINI_API_KEY=
# Also required for Gemini to be used: confirm the Gemini account is one whose terms say content is NOT used to train Google's models
# (a paid / billing-enabled key, not the free tier). The privacy policy promises this; without it Gemini stays off.
# GEMINI_NO_TRAINING_CONFIRMED=1
# Shown on the privacy policy and terms (optional, strongly recommended: Google asks for a way to contact you).
# NEXT_PUBLIC_OPERATOR_NAME=Your Name
# GEMINI_MODEL=gemini-2.5-flash
